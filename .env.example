# Copiá este archivo como .env (no se sube al repo). Valores SOLO para desarrollo local.
POSTGRES_USER=securedata
POSTGRES_PASSWORD=securedata_dev
POSTGRES_DB=securedata
POSTGRES_PORT=5433

# Conexión del dueño del esquema (migraciones, administración).
DATABASE_URL=postgres://securedata:securedata_dev@localhost:5433/securedata
# Conexión que usará la API: rol sin permisos de escritura directa, solo funciones.
DATABASE_URL_API=postgres://securedata_api:api_dev@localhost:5433/securedata
