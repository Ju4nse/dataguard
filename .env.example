# Copiá este archivo como .env (no se sube al repo) y completalo con los datos de tu proyecto de Supabase.
# En Supabase: botón "Connect" (arriba) → "Session pooler" / "Transaction pooler". <ref> es el ID del
# proyecto y <región> sale de esa misma pantalla (ej. aws-0-sa-east-1). No agregues ?sslmode a las URLs:
# el SSL lo configura el código (con verificación del certificado).

# Dueño del esquema (npm run db:migrate / db:seed / db:test / db:totp): pooler en modo sesión, puerto 5432.
# La contraseña es la de la base (Settings → Database → Database password).
DATABASE_URL=postgres://postgres.<ref>:<contraseña-de-la-base>@<región>.pooler.supabase.com:5432/postgres

# Rol con el que se conecta la API (sin escritura directa, solo funciones): pooler en modo transacción, 6543.
DATABASE_URL_API=postgres://securedata_api.<ref>:<contraseña-api>@<región>.pooler.supabase.com:6543/postgres
# La misma <contraseña-api> de arriba (20 caracteres o más): db:migrate se la pone al rol securedata_api.
# Generá una con: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
SECUREDATA_API_PASSWORD=<contraseña-api>

# Opcional: certificado de Supabase (Settings → Database → SSL Configuration → Download certificate).
# Si la conexión falla con "self-signed certificate in certificate chain", descargalo y poné su ruta acá.
# DATABASE_SSL_CA=db/supabase-ca.crt
